{
  "name": "geosweep",
  "version": "0.1.0",
  "private": true,
  "description": "IoT-powered municipal solid-waste collection and fleet tracking platform",
  "workspaces": [
    "geosweep-backend",
    "geosweep-web"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,WEB\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "npm --prefix geosweep-backend run dev",
    "dev:web": "npm --prefix geosweep-web run dev",
    "build": "npm --prefix geosweep-backend run build && npm --prefix geosweep-web run build",
    "build:backend": "npm --prefix geosweep-backend run build",
    "build:web": "npm --prefix geosweep-web run build",
    "typecheck": "npm --prefix geosweep-backend run typecheck && npm --prefix geosweep-web run typecheck",
    "typecheck:backend": "npm --prefix geosweep-backend run typecheck",
    "typecheck:web": "npm --prefix geosweep-web run typecheck",
    "test": "npm --prefix geosweep-backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
