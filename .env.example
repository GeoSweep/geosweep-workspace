# ==========================================
# GeoSweep Environment Configuration (.env.example)
# Copy to .env for local development
# NEVER commit real credentials to version control
# ==========================================

# Backend Configuration
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Supabase PostgreSQL / PostGIS (Phase 01+)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# HiveMQ Cloud MQTT Broker (TLS 8883)
HIVEMQ_HOST=your-cluster-id.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=your-hivemq-username
HIVEMQ_PASSWORD=your-hivemq-password

# Firebase Cloud Messaging (Phase 09+)
FIREBASE_PROJECT_ID=geosweep-fcm-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@geosweep.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dashboard (Vite Frontend)
# Note: Never place backend secrets or service-role keys in VITE_ variables
VITE_API_BASE_URL=http://localhost:4000/api
VITE_BACKEND_URL=http://localhost:4000
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
